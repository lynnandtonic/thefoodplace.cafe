/*--------------------------------------------------------------------
* $NAV
--------------------------------------------------------------------*/

.nav-main
  $font-brandon()
  display: flex
  gap: 20px
  text-transform: uppercase
  font-size: .8em

  a
    display: inline-block
    color: white
    border-bottom: 4px solid transparent
    transition: border-color .3s ease-in-out

    &:hover,
    &:focus
      border-color: white
      outline: none

  @media screen and (min-width: $bp-small + 1)
    padding-top: 20px

    :last-child
      margin-left: auto

  @media screen and (max-width: $bp-small)
    justify-content: center
    padding-top: 40px
    background: linear-gradient(to bottom, $grey-drk 25px, transparent 25px)
    text-align: center
